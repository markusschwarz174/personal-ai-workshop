{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/personal-ai-workshop/experience.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lessons"],
  "properties": {
    "schema_version": {"const": "workshop.experience.v1"},
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lesson", "evidence", "reuse_when", "limitation", "approved_by_human"],
        "properties": {
          "id": {"type": "string", "pattern": "^EXP-[0-9]{4}$"},
          "lesson": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reuse_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "limitation": {"type": "string", "minLength": 1},
          "approved_by_human": {"const": true}
        }
      }
    }
  }
}

